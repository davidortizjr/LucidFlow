generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================
enum UserRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  CODE_SNIPPET
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  MESSAGE_SENT
  USER_JOINED
  USER_LEFT
  PROJECT_CREATED
  COMMENT_ADDED
}

enum NotificationType {
  MESSAGE
  ACTIVITY
}

// ==================== USER ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  avatar        String?
  role          UserRole  @default(MEMBER)
  status        String    @default("online") // online, offline, away
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teams         Team[]
  tasks         Task[]
  assignedTasks Task[]    @relation("AssignedTo")
  messages      Message[]
  channels      Channel[]
  timeRecords   TimeRecord[]
  activityLogs  ActivityLog[]
  documentation CodeDocumentation[]
  notifications Notification[]
  sentInvites   TeamInvite[] @relation("InvitedBy")

  @@index([email])
}

model TeamInvite {
  id          String    @id @default(cuid())
  email       String
  code        String    @unique
  teamId      String
  invitedBy   String    // userId of the person who sent the invite
  status      String    @default("pending") // pending, accepted, expired
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender      User      @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([email, teamId])
  @@index([email])
  @@index([code])
  @@index([teamId])
  @@index([status])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  description String
  isRead      Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

// ==================== TEAM & PROJECT ====================
model Team {
  id          String    @id @default(cuid())
  name        String
  description String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     User[]
  projects    Project[]
  channels    Channel[]
  invites     TeamInvite[]

  @@index([name])
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  teamId      String
  status      String       @default("active") // active, archived, on-hold
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]
  boards      Board[]
  activities  ActivityLog[]

  @@index([teamId])
  @@index([name])
  @@index([status])
  @@index([createdAt])
  @@index([teamId, status]) // Compound index for filtering projects by team and status
}

// ==================== BOARD & TASK ====================
model Board {
  id        String    @id @default(cuid())
  name      String
  projectId String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  boardId      String
  projectId    String
  createdById  String
  assignedToId String?
  dueDate      DateTime?
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  board        Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  comments     Comment[]
  attachments  Attachment[]

  @@index([boardId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([dueDate])
  @@index([projectId, boardId, status]) // Compound index for kanban queries
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model Attachment {
  id        String    @id @default(cuid())
  fileName  String
  fileUrl   String
  fileSize  Int
  fileType  String
  taskId    String
  createdAt DateTime  @default(now())

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ==================== MESSAGING ====================
model Channel {
  id          String    @id @default(cuid())
  name        String
  description String?
  teamId      String
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members     User[]
  messages    Message[]

  @@index([teamId])
  @@index([name])
}

model Conversation {
  id             String    @id @default(cuid())
  participantIds Json     @default("[]") // JSON array of user IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@index([createdAt])
}

model Message {
  id             String         @id @default(cuid())
  content        String
  type           MessageType    @default(TEXT)
  userId         String
  channelId      String?
  conversationId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channelId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([channelId, createdAt])  // Compound index for efficient message pagination by channel
  @@index([conversationId, createdAt]) // Compound index for conversation message queries
}

// ==================== CALENDAR ====================
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  attendeeIds Json     @default("[]") // JSON array of user IDs
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startTime])
}

// ==================== TIME TRACKING ====================
model TimeRecord {
  id           String    @id @default(cuid())
  userId       String
  clockInTime  DateTime
  clockOutTime DateTime?
  duration     Int? // Duration in minutes
  date         DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

// ==================== ACTIVITY LOGS ====================
model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  userId      String
  projectId   String?
  description String?
  metadata    String? // JSON metadata
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt]) // Compound index for user activity history with pagination
  @@index([projectId, createdAt]) // Compound index for project activity feeds
}

// ==================== CODE DOCUMENTATION ====================
model CodeDocumentation {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String // API, Frontend, Database, etc.
  content     String
  createdById String
  version     Int       @default(1)
  isPublished Boolean   @default(true)
  tags        Json     @default("[]") // JSON array of tags
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([createdById])
  @@index([title])
}

// ==================== USER SETTINGS ====================
model UserSettings {
  id            String    @id @default(cuid())
  userId        String    @unique
  theme         String    @default("light")
  language      String    @default("en")
  notifications Boolean   @default(true)
  emailDigest   Boolean   @default(false)
  timezone      String    @default("UTC")
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
